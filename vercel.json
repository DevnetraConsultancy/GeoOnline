{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/data/geo/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] }
  ]
}
